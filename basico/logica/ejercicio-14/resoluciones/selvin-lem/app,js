function esComponenteValido(componente) {
  return componente.gramos > 0;
}

function esCompuestoCompleto(compuesto) {
  return compuesto.componentes.every(esComponenteValido);
}

function calcularMasaTotal(componentes) {
  return componentes.reduce((acumulado, componente) => acumulado + componente.gramos, 0);
}

function procesarCompuestos(listaCompuestos) {
  const completos = [];
  const incompletos = [];

  for (const compuesto of listaCompuestos) {
    const completo = esCompuestoCompleto(compuesto);
    const masaTotal = calcularMasaTotal(compuesto.componentes);

    const resultado = {
      nombre: compuesto.nombre,
      componentes: compuesto.componentes,
      masaTotal,
    };

    if (completo) {
      completos.push(resultado);
    } else {
      const componentesInvalidos = compuesto.componentes.filter(
        (componente) => !esComponenteValido(componente)
      );
      incompletos.push({
        ...resultado,
        componentesInvalidos,
      });
    }
  }

  return { completos, incompletos };
}

const { completos, incompletos } = procesarCompuestos(compuestos);

